{
  "name": "trustchain-server",
  "version": "0.1.0",
  "private": true,
  "description": "TrustChain REST API (Express + MongoDB)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
