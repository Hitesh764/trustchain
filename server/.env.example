# Copy to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=development

# Use 127.0.0.1, not "localhost" -- on some Windows setups Node resolves
# "localhost" to the IPv6 loopback (::1), which MongoDB doesn't listen on.
MONGO_URI=mongodb://127.0.0.1:27017/trustchain

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

# Blockchain (Phase 5). See docs/DEPLOYMENT.md for how to get a real RPC URL,
# a funded Sepolia wallet, and a deployed CONTRACT_ADDRESS. For local dev
# against `npx hardhat node`, SEPOLIA_RPC_URL=http://127.0.0.1:8545 and
# OPERATOR_PRIVATE_KEY is one of the well-known (public, unfunded-on-mainnet)
# accounts hardhat node prints on startup.
SEPOLIA_RPC_URL=
OPERATOR_PRIVATE_KEY=
CONTRACT_ADDRESS=
